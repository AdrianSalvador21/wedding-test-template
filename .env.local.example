# Variable requerida por las rutas de IA (spec 07: app/api/ai/*).
# Es del lado servidor -> NO lleva prefijo NEXT_PUBLIC_, nunca se expone al cliente.
# Copia esta línea a tu .env.local real y pon tu API key de OpenAI.
OPENAI_API_KEY=tu_api_key_de_openai_aqui

# Login y alta de invitaciones (spec 08). Ambas son solo de servidor.
# Clave privada de la cuenta de servicio (Firebase Console -> Project settings ->
# Service accounts -> Generate new private key). Pega el JSON COMPLETO en UNA sola línea,
# sin reformatearlo (el private_key trae \n como texto y se interpreta bien).
# En Vercel: Settings -> Environment Variables (Sensitive) y luego redesplegar.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Correos del operador (ven todas las invitaciones y pueden crear nuevas), separados por coma.
ADMIN_EMAILS=tu_correo@ejemplo.com

# Google Analytics para Firebase y Performance Monitoring (spec 31).
# Measurement ID de la app web (Firebase -> Configuración del proyecto -> Tus apps). Es público.
# Solo se mide si el build es de producción: NEXT_PUBLIC_VERCEL_ENV=production, que Vercel expone
# solo (no la definas a mano). En local y en las vistas previas no se envía nada, salvo que abras
# una página con ?ga_debug=1 (se ve en GA4 -> DebugView; ?ga_debug=0 lo apaga en la pestaña).
# Al ser NEXT_PUBLIC_*, se incrusta en el build: tras cambiarla en Vercel hay que redesplegar.
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-xxxxxxxxxx

# Etiqueta base de Google Ads (gtag.js). Se carga solo en marketing/demo/admin, nunca en
# invitaciones reales. Las conversiones se importan desde GA4 (generate_lead, sign_up). Sin esta variable el
# componente no hace nada (desarrollo local y ramas de vista previa no cargan el tag).
# Se obtiene en Google Ads: Herramientas > Medición > Conversiones > Detalles de la etiqueta.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-xxxxxxxxxxx
