# Variable requerida por las rutas de IA (spec 07: app/api/ai/*).
# Es del lado servidor -> NO lleva prefijo NEXT_PUBLIC_, nunca se expone al cliente.
# Copia esta línea a tu .env.local real y pon tu API key de OpenAI.
OPENAI_API_KEY=tu_api_key_de_openai_aqui

# Login y alta de invitaciones (spec 08). Ambas son solo de servidor.
# Clave privada de la cuenta de servicio (Firebase Console -> Project settings ->
# Service accounts -> Generate new private key). Pega el JSON COMPLETO en UNA sola línea,
# sin reformatearlo (el private_key trae \n como texto y se interpreta bien).
# En Vercel: Settings -> Environment Variables (Sensitive) y luego redesplegar.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Correos del operador (ven todas las invitaciones y pueden crear nuevas), separados por coma.
ADMIN_EMAILS=tu_correo@ejemplo.com

# Analítica con PostHog (spec 11). Sin NEXT_PUBLIC_POSTHOG_KEY la analítica no hace nada
# (desarrollo local y ramas de vista previa no envían datos).
# La clave es la "Project API key" pública de PostHog Cloud (región US), no una clave secreta.
# Al ser NEXT_PUBLIC_*, se incrusta en el build: tras cambiarla en Vercel hay que redesplegar.
NEXT_PUBLIC_POSTHOG_KEY=
# Ruta del proxy del propio dominio (next.config.js) hacia PostHog. No la cambies.
NEXT_PUBLIC_POSTHOG_HOST=/ingest
